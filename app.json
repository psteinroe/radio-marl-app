{
	"expo": {
		"name": "Radio Marl",
		"slug": "radio-marl-app",
		"version": "1.1.0",
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"scheme": "radio-marl",
		"userInterfaceStyle": "automatic",
		"splash": {
			"image": "./assets/images/splash.png",
			"resizeMode": "contain",
			"backgroundColor": "#EEF2f2"
		},
		"assetBundlePatterns": ["**/*"],
		"ios": {
			"config": {
				"usesNonExemptEncryption": false
			},
			"bundleIdentifier": "com.radio-marl.app",
			"supportsTablet": false,
			"infoPlist": {
				"UIBackgroundModes": ["audio"]
			}
		},
		"android": {
			"adaptiveIcon": {
				"foregroundImage": "./assets/images/adaptive-icon.png",
				"backgroundColor": "#EEF2f2"
			},
			"package": "com.radio_marl.app"
		},
		"plugins": [
			"expo-router",
			"expo-font",
			[
				"expo-build-properties",
				{
					"ios": {
						"deploymentTarget": "16.0"
					}
				}
			]
		],
		"experiments": {
			"typedRoutes": true
		},
		"extra": {
			"router": {
				"origin": false
			},
			"eas": {
				"projectId": "db61a7c0-2fcb-4b6d-91f6-65dd4369e3c3"
			}
		},
		"owner": "radio-marl",
		"runtimeVersion": {
			"policy": "appVersion"
		},
		"updates": {
			"url": "https://u.expo.dev/db61a7c0-2fcb-4b6d-91f6-65dd4369e3c3"
		}
	}
}
