{
	"name": "radio-marl-app",
	"main": "expo-router/entry",
	"version": "1.0.0",
	"scripts": {
		"install:dev-client-ios-simulator": "NODE_ENV=development eas build:run -p ios --latest",
		"install:dev-client-android-simulator": "NODE_ENV=development eas build:run -p android --latest",
		"build:dev-clients": "bun run build:dev-clients-simulator && bun run build:dev-clients",
		"build:dev-clients-simulator": "eas build --profile dev-client-simulator --platform all --non-interactive --no-wait",
		"build:dev-clients": "eas build --profile dev-client --platform all --non-interactive --no-wait",
		"start": "NODE_ENV=development expo start --dev-client",
		"start:ios": "NODE_ENV=development expo start --ios --dev-client",
		"start:android": "NODE_ENV=development expo start --android --dev-client",
		"deploy:native": "eas build --auto-submit --profile=main --message=$SHA --platform=all --non-interactive --no-wait",
		"deploy": "eas update --auto --non-interactive",
		"typecheck": "tsc --pretty --noEmit",
		"check": "biome check",
		"fix": "biome check --write"
	},
	"dependencies": {
		"@expo/vector-icons": "^14.0.0",
		"@react-navigation/native": "^6.0.2",
		"@tanstack/react-query": "5.24.6",
		"expo": "^51.0.0",
		"expo-av": "~14.0.6",
		"expo-dev-client": "~4.0.20",
		"expo-font": "~12.0.9",
		"expo-image": "~1.12.13",
		"expo-linking": "~6.3.1",
		"expo-router": "~3.5.18",
		"expo-splash-screen": "0.27.5",
		"expo-status-bar": "~1.12.1",
		"expo-system-ui": "~3.0.7",
		"expo-updates": "~0.25.21",
		"expo-web-browser": "~13.0.3",
		"lucide-react-native": "^0.344.0",
		"nativewind": "4.0.22",
		"react": "18.2.0",
		"react-dom": "18.2.0",
		"react-native": "0.74.3",
		"react-native-gesture-handler": "~2.16.1",
		"react-native-reanimated": "~3.10.1",
		"react-native-safe-area-context": "4.10.5",
		"react-native-screens": "3.31.1",
		"react-native-svg": "15.2.0",
		"react-native-track-player": "^4.0.1",
		"react-native-web": "~0.19.6",
		"tailwindcss": "^3.4.1"
	},
	"devDependencies": {
		"@babel/core": "^7.24.0",
		"@biomejs/biome": "1.8.3",
		"@types/react": "~18.2.79",
		"react-test-renderer": "18.2.0",
		"typescript": "^5.1.3"
	},
	"overrides": {
		"react-refresh": "~0.14.0"
	},
	"resolutions": {
		"react-refresh": "~0.14.0"
	},
	"private": true
}
