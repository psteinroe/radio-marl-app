{
	"name": "radio-marl-app",
	"main": "index.js",
	"version": "1.1.0",
	"packageManager": "pnpm@10.12.1",
	"engines": {
		"node": ">=20.19"
	},
	"scripts": {
		"install:dev-client-ios-simulator": "NODE_ENV=development eas build:run -p ios --latest",
		"install:dev-client-android-simulator": "NODE_ENV=development eas build:run -p android --latest",
		"build:dev-clients": "eas build --profile dev-client --platform all --non-interactive --no-wait",
		"build:dev-clients-simulator": "eas build --profile dev-client-simulator --platform all --non-interactive --no-wait",
		"e2e:android": "maestro test -e APP_ID=com.radio_marl.app .maestro/suite.yml",
		"e2e:ios": "maestro test -e APP_ID=com.radio-marl.app .maestro/suite.yml",
		"start": "NODE_ENV=development expo start --dev-client",
		"start:ios": "NODE_ENV=development expo start --ios --dev-client --clear",
		"start:android": "NODE_ENV=development expo start --android --dev-client",
		"deploy:native": "eas build --auto-submit --profile=main --message=$SHA --platform=all --non-interactive --no-wait",
		"deploy": "eas update --auto --platform all --environment production --non-interactive",
		"typecheck": "tsc --pretty --noEmit",
		"check": "biome check .",
		"fix": "biome check --write .",
		"test": "tsx --test tests/*.test.mjs",
		"doctor": "npx --yes expo-doctor@latest",
		"validate": "tsc --pretty --noEmit && biome check . && tsx --test tests/*.test.mjs"
	},
	"dependencies": {
		"@react-navigation/native": "^7.1.33",
		"@rntp/player": "5.7.0",
		"@tanstack/react-query": "5.101.4",
		"expo": "^55.0.28",
		"expo-build-properties": "~55.0.16",
		"expo-constants": "~55.0.17",
		"expo-dev-client": "~55.0.37",
		"expo-font": "~55.0.8",
		"expo-image": "~55.0.11",
		"expo-linking": "~55.0.16",
		"expo-router": "~55.0.17",
		"expo-splash-screen": "55.0.23",
		"expo-status-bar": "~55.0.6",
		"expo-system-ui": "~55.0.20",
		"expo-updates": "~55.0.26",
		"expo-web-browser": "~55.0.18",
		"lucide-react-native": "^1.27.0",
		"react": "19.2.0",
		"react-dom": "19.2.0",
		"react-native": "0.83.10",
		"react-native-safe-area-context": "5.6.2",
		"react-native-screens": "4.23.0",
		"react-native-svg": "15.15.3",
		"react-native-web": "~0.21.2"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@biomejs/biome": "2.5.6",
		"@types/node": "^20.19.43",
		"@types/react": "~19.2.17",
		"babel-preset-expo": "^55.0.24",
		"tsx": "^4.23.1",
		"typescript": "^5.9.3"
	},
	"private": true
}
